# Copy this file to .env and replace every placeholder. Never commit .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/crafthub
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Google Sign-In. This is the Web OAuth client ID, not a client secret.
# It is also supplied to Flutter as GOOGLE_WEB_CLIENT_ID via --dart-define.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Short-lived, opaque pending-profile token lifetime (5-30 minutes).
GOOGLE_PENDING_REGISTRATION_TTL_MINUTES=15

# Existing email/OTP settings (keep your current Brevo/SMTP values here).
OTP_EXPIRY_MINUTES=15
SMTP_REQUIRED=true
SMTP_SERVICE=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
SMTP_FROM=Craft Hub <no-reply@example.com>
